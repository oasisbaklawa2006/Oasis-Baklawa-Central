<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/oasis_background">

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Offline / reconnect overlay. Shown over the (possibly stale) last
         rendered frame so the operator always knows the display is not live,
         per the "no stale data shown as live" requirement. -->
    <LinearLayout
        android:id="@+id/offlineOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC0B0E14"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminateTint="@color/oasis_gold" />

        <TextView
            android:id="@+id/offlineTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/offline_title"
            android:textColor="@color/oasis_text"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/offlineBody"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/offline_body"
            android:textColor="@color/oasis_text"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Unassigned-department fail-closed state. -->
    <LinearLayout
        android:id="@+id/unassignedOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/oasis_background"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="48dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/unassigned_department_title"
            android:textColor="@color/oasis_error"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/unassigned_department_body"
            android:textColor="@color/oasis_text"
            android:textSize="16sp"
            android:gravity="center" />
    </LinearLayout>

    <TextView
        android:id="@+id/staleDataBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:background="#AAE5484D"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:text="@string/stale_data_warning"
        android:textColor="@android:color/white"
        android:textSize="12sp"
        android:visibility="gone" />

</FrameLayout>
