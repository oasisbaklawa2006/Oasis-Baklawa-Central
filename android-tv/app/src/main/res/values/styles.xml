<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.OasisTv" parent="Theme.Leanback">
        <item name="android:windowBackground">@color/oasis_background</item>
        <item name="android:colorBackground">@color/oasis_background</item>
    </style>

    <!-- Fullscreen immersive kiosk theme for MainActivity: no status/nav bar, no
         action bar. Immersive-sticky mode is additionally applied at runtime in
         MainActivity so it survives WebView-driven layout changes. -->
    <style name="Theme.OasisTv.Kiosk" parent="Theme.OasisTv">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="28">shortEdges</item>
    </style>
</resources>
