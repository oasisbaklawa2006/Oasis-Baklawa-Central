<?xml version="1.0" encoding="utf-8"?>
<!-- API 24-25 fallback (no adaptive-icon support); overridden by
     mipmap-anydpi-v26/ic_launcher.xml on API 26+. Vector drawables are valid
     launcher icons back to API 21 via AAPT vector support, so no raster PNG
     is required here. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@drawable/ic_launcher_background" />
    <item android:drawable="@drawable/ic_launcher_foreground" />
</layer-list>
