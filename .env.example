# Oasis AI Studio — Environment Variables
# Copy this file to .env and fill in values from Supabase Dashboard > Settings > API
# NEVER commit .env to Git

# Supabase Project URL (from Settings > API > Project URL)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Supabase Anon/Publishable Key (from Settings > API > anon public)
# This is safe for frontend — it is NOT the service_role key
VITE_SUPABASE_PUBLISHABLE_KEY=eyJ...your_anon_key_here

# Optional: Project ref for reference only
# VITE_SUPABASE_PROJECT_ID=your_project_ref
