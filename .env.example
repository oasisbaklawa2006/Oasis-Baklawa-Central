# Oasis Baklawa Central — copy to .env (never commit .env)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Non-VITE-prefixed duplicates used by some build/server-side tooling
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Buyer email OTP / magic-link confirm uses window.location.origin at runtime.
# Supabase Auth → URL configuration must allow Central redirect URLs such as:
#   https://oasis-baklawa-central.vercel.app/buyer/login
#   https://oasisbaklawa.com/buyer/login
# Do not point Buyer email OTP at https://b2b.oasisbaklawa.com.

# Edge function secrets (set in Supabase dashboard/CLI — NOT in this file):
# RESEND_API_KEY
# SUPABASE_SERVICE_ROLE_KEY
